{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "graphify": {
      "command": "python",
      "args": [
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    }
  }
}